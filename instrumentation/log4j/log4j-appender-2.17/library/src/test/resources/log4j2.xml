<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout
        pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} traceId: %X{trace_id} spanId: %X{span_id} flags: %X{trace_flags} - %msg%n"/>
    </Console>
    <!-- TODO run tests both with and without experimental log attributes -->
    <!-- captureContextDataAttributes is retained for deprecated XML compatibility. -->
    <OpenTelemetry name="OpenTelemetryAppender" numLogsCapturedBeforeOtelInstall="1" captureMapMessageAttributes="true" captureMarkerAttribute="true" captureContextDataAttributes="key1,key2" captureExperimentalAttributes="true" captureCodeAttributes="true"/>
    <OpenTelemetry name="OpenTelemetryContextDataSelectorAppender" numLogsCapturedBeforeOtelInstall="1" contextDataAttributesIncluded="selector-*" contextDataAttributesExcluded="*-secret"/>
    <OpenTelemetry name="OpenTelemetryMapMessageSelectorAppender" numLogsCapturedBeforeOtelInstall="1" mapMessageAttributesIncluded="selector-*" mapMessageAttributesExcluded="*-secret"/>
    <!-- captureMapMessageAttributes is retained for deprecated XML compatibility and must lose to the patterns. -->
    <OpenTelemetry name="OpenTelemetryMapMessageSelectorPrecedenceAppender" numLogsCapturedBeforeOtelInstall="1" mapMessageAttributesIncluded="selector-*" mapMessageAttributesExcluded="*-secret" captureMapMessageAttributes="true"/>
  </Appenders>
  <Loggers>
    <Logger name="TestLogger" level="All">
      <AppenderRef ref="OpenTelemetryAppender"/>
      <AppenderRef ref="Console"/>
    </Logger>
    <Logger name="abc" level="info">
      <AppenderRef ref="OpenTelemetryAppender"/>
      <AppenderRef ref="Console"/>
    </Logger>
    <Logger name="ContextDataSelectorTestLogger" level="All">
      <AppenderRef ref="OpenTelemetryContextDataSelectorAppender"/>
    </Logger>
    <Logger name="MapMessageSelectorTestLogger" level="All">
      <AppenderRef ref="OpenTelemetryMapMessageSelectorAppender"/>
    </Logger>
    <Logger name="MapMessageSelectorPrecedenceTestLogger" level="All">
      <AppenderRef ref="OpenTelemetryMapMessageSelectorPrecedenceAppender"/>
    </Logger>
    <Root level="All">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
