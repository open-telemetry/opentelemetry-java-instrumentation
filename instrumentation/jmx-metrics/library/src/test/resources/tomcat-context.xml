<Context>
  <Resource name="jdbc/TestDB"
            auth="Container"
            type="javax.sql.DataSource"
            factory="org.apache.tomcat.dbcp.dbcp2.BasicDataSourceFactory"
            initialSize="0"
            maxTotal="10"
            maxIdle="5"
            driverClassName="org.h2.Driver"
            url="jdbc:h2:mem:test"/>
</Context>
