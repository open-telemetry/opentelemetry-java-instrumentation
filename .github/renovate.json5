{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Renovate merges these rules over the shared config on main.
  packageRules: [
    {
      matchBaseBranches: [
        'maintenance/v2.x',
      ],
      matchPackageNames: [
        'com.google.googlejavaformat:google-java-format',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
  ],
}
