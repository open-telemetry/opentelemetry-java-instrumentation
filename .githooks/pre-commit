#!/bin/bash
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'

# Spotless still owns Scala, Groovy, and the miscellaneous files listed here. Flint
# owns changed-file discovery; the ownership patterns remain a property of this
# caller so that adding a Spotless target does not require a Flint release.
temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/otel-pre-commit.XXXXXX")
trap 'rm -rf "$temp_dir"' EXIT

# Keep staged and unstaged changes separate so this also works before the first
# commit, when HEAD does not exist. `git diff --cached` compares the index with
# the empty tree on an unborn branch. The fixed separator makes the two binary
# diffs unambiguous while keeping the snapshot independent of Git's color and
# rename configuration.
snapshot_tracked_diffs() {
  local output=$1
  if ! : >"$output"; then
    return 1
  fi
  if ! git diff --no-ext-diff --no-color --no-renames --binary -- >"$output"; then
    return 1
  fi
  if ! printf '\0' >>"$output"; then
    return 1
  fi
  if ! git diff --cached --no-ext-diff --no-color --no-renames --binary -- >>"$output"; then
    return 1
  fi
}

spotless_files="$temp_dir/spotless-files"
if ! mise exec -- flint changed-files --null \
  --include '*.scala' \
  --include '*.groovy' \
  --include '.gitignore' \
  --include '.gitattributes' \
  --include '.gitconfig' \
  --include '.editorconfig' \
  --include 'gradle.properties' \
  --include '.github/**/*.sh' \
  --include 'examples/**/gradle.properties' \
  >"$spotless_files"; then
  echo "Unable to determine Spotless-owned changed files with Flint." >&2
  exit 1
fi

# Flint's globs intentionally match repository-relative paths by basename, so
# filter the broad dot-files and gradle.properties results here to match the
# exact root-level and nested Spotless targets. Keep the NUL-delimited output in
# a file rather than putting paths in a shell variable.
run_spotless=false
while IFS= read -r -d '' file; do
  if [[ "$file" == *.scala || "$file" == *.groovy \
    || "$file" == .gitignore || "$file" == .gitattributes \
    || "$file" == .gitconfig || "$file" == .editorconfig \
    || "$file" == gradle.properties \
    || "$file" =~ ^\.github/.*\.sh$ \
    || "$file" =~ ^examples/(.*/)?gradle\.properties$ ]]; then
    run_spotless=true
    break
  fi
done <"$spotless_files"

lint_failed=false
if ! mise run lint; then
  lint_failed=true
fi

spotless_failed=false
spotless_changed=false
if [[ "$run_spotless" == true ]]; then
  before_diff="$temp_dir/before.diff"
  after_diff="$temp_dir/after.diff"

  # Capture the complete tracked worktree state, including both staged and
  # unstaged changes. Spotless must not change the index, and any worktree
  # changes it makes are reported so the commit can be retried explicitly.
  if ! snapshot_tracked_diffs "$before_diff"; then
    echo "Unable to snapshot tracked changes before Spotless." >&2
    exit 1
  fi
  if ! ./gradlew spotlessApply; then
    spotless_failed=true
  fi
  if ! snapshot_tracked_diffs "$after_diff"; then
    echo "Unable to snapshot tracked changes after Spotless." >&2
    exit 1
  fi
  if ! cmp -s "$before_diff" "$after_diff"; then
    spotless_changed=true
  fi
fi

lint_fix_failed=false
if [[ "$lint_failed" == true || "$spotless_failed" == true || "$spotless_changed" == true ]]; then
  if ! mise run lint:fix --allow-fixed; then
    lint_fix_failed=true
  fi
fi

if [[ "$lint_failed" == true || "$lint_fix_failed" == true || "$spotless_failed" == true || "$spotless_changed" == true ]]; then
  echo ""
  echo ""
  if [[ "$spotless_changed" == true ]]; then
    echo -e "\033[0;33mSpotless formatted tracked files; please git diff/add and recommit."
  else
    echo -e "\033[0;33mCode has been formatted; please git diff/add and recommit."
  fi
  echo ""
  echo ""
  exit 1
fi
