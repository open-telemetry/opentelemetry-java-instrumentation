#!/bin/bash
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'

# Spotless still owns Scala, Groovy, and miscellaneous files. To keep commits fast,
# run it here only when staged Scala or Groovy files need formatting; spotlessMisc
# remains covered by CI's full spotlessCheck.
run_spotless=false
while IFS= read -r -d '' file; do
  case "$file" in
    *.scala | *.groovy)
      run_spotless=true
      break
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ! mise run lint || { [[ "$run_spotless" == true ]] && ! ./gradlew spotlessCheck; }; then
  if [[ "$run_spotless" == true ]]; then
    ./gradlew spotlessApply
  fi
  mise run lint:fix
  echo ""
  echo ""
  echo -e "\033[0;33mCode has been formatted; please git diff/add and recommit."
  echo ""
  echo ""
  exit 1
fi
